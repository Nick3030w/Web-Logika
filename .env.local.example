# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-side only — do NOT add the NEXT_PUBLIC_ prefix)
# Firebase console > Project settings > Service accounts > Generate new key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Storage bucket name, without gs:// and without https://
# Firebase console > Storage. Newer projects look like <project-id>.firebasestorage.app
# and older ones like <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ---------------------------------------------------------------------------
# Public business phone used by every WhatsApp CTA (country code + number)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_PHONE=573001234567

# ---------------------------------------------------------------------------
# Set to false once the real catalog is published in Firestore so the demo
# products never show up on the live site.
# ---------------------------------------------------------------------------
USE_MOCK_PRODUCTS=true
