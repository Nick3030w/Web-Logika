rules_version = '2';

// All reads and writes from the website happen through the Admin SDK on the
// server, so client access is denied. Products stay publicly readable in case a
// client SDK is ever added.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /contacts/{contactId} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
